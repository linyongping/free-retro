{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free-retro",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_ROOM", "class_name": "BoardRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "free-retro-db",
      "database_id": "9d4e09ae-0c67-45b4-943f-2ff76c0d5a98"
    }
  ]
}
